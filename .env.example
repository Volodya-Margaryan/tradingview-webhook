# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Shared secret that must appear in every TradingView alert JSON payload
# (field name: "secret"). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Seconds within which a repeat alert for the same symbol+action is ignored
DEDUP_WINDOW_SECONDS=30

# --- paper account ---
STARTING_EQUITY=100000

# --- risk rules ---
MAX_RISK_PER_TRADE_PCT=1.0
MAX_POSITION_NOTIONAL_PCT=20.0
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS_PCT=5.0
ALLOW_SHORTS=false

# Kill switch — set true to block all signal processing on next server start.
# For an immediate stop on an already-running server, use instead:
#   python cli.py killswitch on
KILL_SWITCH=false

# --- server ---
HOST=0.0.0.0
PORT=8000
